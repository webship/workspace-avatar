{
  "name": "@webship.co/workspace-avatar",
  "version": "1.0.0-beta2",
  "description": "The Avatars workspace for Webship Workspace: the `avatars/` folder (type code), its settings file, its 8 commands and its docs, activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-avatar.git"
  },
  "files": [
    "dist/src",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "avatar",
    "label": "Avatars",
    "workspace": {
      "key": "avatars",
      "settingsTemplate": "config/workspace.avatars.settings.yml",
      "files": [
        "commands/cmd-avatar-project.sh",
        "commands/cmd-tools-avatar-agent.sh",
        "commands/cmd-tools-avatar-catalog.sh",
        "commands/cmd-tools-avatar-character.sh",
        "commands/cmd-tools-avatar-voice.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh",
        "commands/cmd-tools-screen.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "features": [
      "features/avatar.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-beta1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

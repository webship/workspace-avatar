{
  "name": "@webship.co/workspace-avatar",
  "version": "1.0.8",
  "description": "The Avatars plugin for Webship Workspace: the `avatars/` folder (type code), its settings file, its 9 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), and speech to speech for the AI Assistant (talk to it and hear it answer, with a recogniser and a voice on this machine or the browser's own), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-avatar.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "public",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "avatar",
    "label": "Avatars",
    "settingsFile": "plugin.avatar.settings.yml",
    "settingsTemplate": "config/plugin.avatar.settings.yml",
    "labels": "config/settings.labels.yml",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "workspace": {
      "key": "avatars",
      "settingsTemplate": "config/workspace.avatars.settings.yml",
      "files": [
        "commands/cmd-avatar-project.sh",
        "commands/cmd-tools-avatar-agent.sh",
        "commands/cmd-tools-avatar-catalog.sh",
        "commands/cmd-tools-avatar-character.sh",
        "commands/cmd-tools-avatar-voice.sh",
        "commands/cmd-tools-avatar-speech.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh",
        "commands/cmd-tools-screen.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/avatars-character-maker.md"
      ],
      "skills": [
        "ai/skills/avatars-workflow"
      ],
      "commands": [
        "ai/commands/avatars-add-character.md"
      ],
      "prompts": [
        "ai/prompts/avatars-build-a-character.md"
      ]
    },
    "features": [
      "features/avatar.feature",
      "features/avatar-speech.feature"
    ],
    "scripts": {
      "functions": [
        "scripts/functions/fun-avatar-speech.sh"
      ],
      "args": [
        "scripts/args/arg-avatar-speech.sh"
      ]
    },
    "css": [
      "public/speech.css"
    ],
    "js": [
      "public/speech-core.js",
      "public/speech-speak.js",
      "public/speech-loop.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  }
}
